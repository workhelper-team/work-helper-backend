package com.workhelper.domain.consultation.service;

import com.workhelper.domain.consultation.dto.ConsultationMessageRequestDto;
import com.workhelper.domain.consultation.dto.ConsultationMessageResponseDto;
import com.workhelper.domain.consultation.entity.ConsultationMessage;
import com.workhelper.domain.consultation.repository.ConsultationMessageRepository;
import com.workhelper.domain.laborcase.entity.LaborCase;
import com.workhelper.domain.laborcase.repository.LaborCaseRepository;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.List;
import java.util.stream.Collectors;


// ============================================================
// 상담 메시지 Service
// Controller에서 전달받은 요청을 실제 비즈니스 로직으로 처리
// ============================================================
@Service

// final 필드에 필요한 Repository를 생성자를 통해 자동 주입
@RequiredArgsConstructor

// 기본적으로 조회 작업은 읽기 전용 트랜잭션으로 처리
@Transactional(readOnly = true)
public class ConsultationMessageService {

    // 상담 메시지의 저장 및 조회를 담당하는 Repository
    private final ConsultationMessageRepository consultationMessageRepository;

    // 노동 사건의 존재 여부 및 사건 정보 조회를 담당하는 Repository
    private final LaborCaseRepository laborCaseRepository;


    // ============================================================
    // 상담 메시지 조회
    // 특정 사건(caseId)에 연결된 상담 메시지를 조회
    // ============================================================
    public List<ConsultationMessageResponseDto> getMessages(Long caseId) {

        // 해당 사건에 연결된 상담 메시지를 조회하고
        // 메시지 ID 순서대로 정렬
        List<ConsultationMessage> messages =
                consultationMessageRepository.findByLaborCaseIdOrderByIdAsc(caseId);

        // Entity 목록을 Response DTO 목록으로 변환
        // DB Entity를 그대로 외부에 반환하지 않고 DTO로 전달
        return messages.stream()
                .map(ConsultationMessageResponseDto::new)
                .collect(Collectors.toList());
    }


    // ============================================================
    // 상담 메시지 전송
    // 사용자가 보낸 메시지를 저장하고 AI 답변을 생성
    // ============================================================
    @Transactional
    public ConsultationMessageResponseDto sendMessage(
            Long caseId,
            ConsultationMessageRequestDto requestDto
    ) {

        // --------------------------------------------------------
        // 1. 해당 사건이 실제로 존재하는지 확인
        // --------------------------------------------------------
        LaborCase laborCase = laborCaseRepository.findById(caseId)
                .orElseThrow(() ->
                        new IllegalArgumentException(
                                "해당 사건을 찾을 수 없습니다. ID: " + caseId
                        )
                );


        // --------------------------------------------------------
        // 2. 사용자가 보낸 상담 메시지 생성
        // --------------------------------------------------------
        ConsultationMessage userMessage = ConsultationMessage.builder()
                // 해당 노동 사건과 상담 메시지를 연결
                .laborCase(laborCase)

                // 메시지를 보낸 주체를 USER로 지정
                .senderType("USER")

                // Request DTO에서 사용자의 메시지 내용을 가져옴
                .content(requestDto.getContent())

                .build();


        // --------------------------------------------------------
        // 3. 사용자 메시지를 DB에 저장
        // --------------------------------------------------------
        consultationMessageRepository.save(userMessage);


        // --------------------------------------------------------
        // 4. AI 답변 생성
        //
        // 현재는 테스트용 예시 답변이며,
        // 실제 서비스에서는 LLM / RAG 등의 AI 로직으로 교체
        // --------------------------------------------------------
        String aiAnswer = "AI 답변 예시입니다.";

        // AI가 상담 내용을 분석한 구조화 결과 예시
        String structuredResult =
                "{\"summary\": \"구조화된 결과 예시\"}";


        // --------------------------------------------------------
        // 5. AI 답변을 상담 메시지 Entity로 생성
        // --------------------------------------------------------
        ConsultationMessage aiMessage = ConsultationMessage.builder()
                // 사용자 메시지와 동일한 노동 사건에 연결
                .laborCase(laborCase)

                // 메시지를 보낸 주체를 AI로 지정
                .senderType("AI")

                // AI가 생성한 답변 저장
                .content(aiAnswer)

                // AI 분석 결과 저장
                .structuredResult(structuredResult)

                .build();


        // --------------------------------------------------------
        // 6. AI 답변을 DB에 저장
        // --------------------------------------------------------
        ConsultationMessage savedAiMessage =
                consultationMessageRepository.save(aiMessage);


        // --------------------------------------------------------
        // 7. 저장된 AI 답변을 Response DTO로 변환하여 반환
        // Controller를 통해 클라이언트에게 전달
        // --------------------------------------------------------
        return new ConsultationMessageResponseDto(savedAiMessage);
    }
}